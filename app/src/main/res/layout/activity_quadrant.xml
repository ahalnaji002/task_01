<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/QuadCard"
            android:background="#FFEADDFF">

            <TextView
                style="@style/QuadCardTitle"
                android:text="@string/quad_text_title" />

            <TextView
                style="@style/QuadCardDesc"
                android:text="@string/quad_text_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/QuadCard"
            android:background="#FFD0BCFF">

            <TextView
                style="@style/QuadCardTitle"
                android:text="@string/quad_image_title" />

            <TextView
                style="@style/QuadCardDesc"
                android:text="@string/quad_image_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/QuadCard"
            android:background="#FFB69DF8">

            <TextView
                style="@style/QuadCardTitle"
                android:text="@string/quad_row_title" />

            <TextView
                style="@style/QuadCardDesc"
                android:text="@string/quad_row_desc" />
        </LinearLayout>

        <LinearLayout
            style="@style/QuadCard"
            android:background="#FFF6EDFF">

            <TextView
                style="@style/QuadCardTitle"
                android:text="@string/quad_column_title" />

            <TextView
                style="@style/QuadCardDesc"
                android:text="@string/quad_column_desc" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BirthdayCardActivity"
            android:label="@string/menu_birthday"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".TaskDoneActivity"
            android:label="@string/menu_task_done"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".QuadrantActivity"
            android:label="@string/menu_quadrant"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ArticleActivity"
            android:label="@string/menu_article"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".BusinessCardActivity"
            android:label="@string/menu_business_card"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
